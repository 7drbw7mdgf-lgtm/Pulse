{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "1.5.8",
  "identifier": "com.pulse.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Education",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/backend"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
