# Copy to .env on the server only; chmod 600 .env. Never commit the real values.
PULSE_AUTH_DOMAIN=auth.your-domain.example
MENDELEY_CLIENT_ID=YOUR_REGISTERED_APPLICATION_ID
MENDELEY_CLIENT_SECRET=YOUR_REGISTERED_APPLICATION_SECRET
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PULSE_TOKEN_KEY=YOUR_GENERATED_FERNET_KEY
